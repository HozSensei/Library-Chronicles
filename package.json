{
  "name": "vertical-deck-reader",
  "version": "0.1.0",
  "description": "Lecteur BD/Manga vertical optimisé ROG Ally X (Electron + Vue 3)",
  "main": "./out/main/index.js",
  "author": "Library Chronicles",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "preview": "electron-vite preview",
    "test:remap": "node scripts/verify-portrait-remap.mjs",
    "test:cbz": "node scripts/verify-cbz.mjs",
    "test:pdf": "node scripts/verify-pdf.mjs",
    "test:watcher": "node scripts/verify-watcher.mjs",
    "test:haptics": "node scripts/verify-haptics.mjs",
    "test:series": "node scripts/verify-series.mjs",
    "test:metadata": "node scripts/verify-metadata.mjs",
    "test:bounds": "node scripts/verify-window-bounds.mjs",
    "test": "npm run test:remap && npm run test:cbz && npm run test:pdf && npm run test:watcher && npm run test:haptics && npm run test:series && npm run test:metadata && npm run test:bounds",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "postinstall": "node scripts/rebuild-native.mjs || true",
    "predist": "npm run rebuild:native",
    "predist:win": "npm run rebuild:native",
    "dist": "npm run build && electron-builder --win",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "pack": "npm run dist:dir"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.2.5",
    "@fontsource/syne": "^5.2.5",
    "better-sqlite3": "^11.7.0",
    "jszip": "^3.10.1",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.librarychronicles.verticaldeckreader",
    "productName": "Vertical Deck Reader",
    "copyright": "Copyright © Library Chronicles",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.{node,dll}",
      "**/better-sqlite3/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vertical Deck Reader"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "npmRebuild": true,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "electronLanguages": [
      "fr",
      "en-US"
    ]
  }
}
