{
  "name": "vertical-deck-reader",
  "version": "0.1.0",
  "description": "Lecteur BD/Manga vertical optimisé ROG Ally X (Electron + Vue 3)",
  "main": "./out/main/index.js",
  "author": "Library Chronicles",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "preview": "electron-vite preview",
    "test:remap": "node scripts/verify-portrait-remap.mjs",
    "test:cbz": "node scripts/verify-cbz.mjs",
    "test:epub": "node scripts/verify-epub.mjs",
    "test:pdf": "node scripts/verify-pdf.mjs",
    "test:watcher": "node scripts/verify-watcher.mjs",
    "test:haptics": "node scripts/verify-haptics.mjs",
    "test:series": "node scripts/verify-series.mjs",
    "test:series-folder": "node scripts/verify-series-folder.mjs",
    "test:metadata": "node scripts/verify-metadata.mjs",
    "test:meta-mappers": "node scripts/verify-meta-mappers.mjs",
    "test:provider-test": "node scripts/verify-provider-test-status.mjs",
    "test:bounds": "node scripts/verify-window-bounds.mjs",
    "test:setup-focus": "node scripts/verify-setup-focus.mjs",
    "test:settings-focus": "node scripts/verify-settings-focus.mjs",
    "test:theme-accents": "node scripts/verify-theme-accents.mjs",
    "test:i18n": "node scripts/verify-i18n.mjs",
    "test:focus-scroll": "node scripts/verify-focus-scroll.mjs",
    "test:stick-nav": "node scripts/verify-stick-menu-nav.mjs",
    "test:text-input": "node scripts/verify-text-input-focus.mjs",
    "test:hud-modal": "node scripts/verify-reader-hud-modal.mjs",
    "test:gamepad-reader": "node scripts/verify-gamepad-reader-path.mjs",
    "test:book-focus": "node scripts/verify-book-focus.mjs",
    "test:reader-strip": "node scripts/verify-reader-strip.mjs",
    "test:page-view": "node scripts/verify-page-view-transform.mjs",
    "test:library-all-tab": "node scripts/verify-library-all-tab.mjs",
    "test:library-nav-continue": "node scripts/verify-library-nav-continue.mjs",
    "test:library-empty": "node scripts/verify-library-empty.mjs",
    "test:import-list-detail": "node scripts/verify-import-list-detail.mjs",
    "test:import-meta-search": "node scripts/verify-import-meta-search.mjs",
    "test:app-routes": "node scripts/verify-app-routes.mjs",
    "test:meta-apply-fields": "node scripts/verify-meta-apply-fields.mjs",
    "test:plain-clone": "node scripts/verify-plain-clone.mjs",
    "test:series-tome": "node scripts/verify-series-tome-fiches.mjs",
    "test:adjacent-tome": "node scripts/verify-reader-adjacent-tome.mjs",
    "test:perf-cache": "node scripts/verify-perf-cache.mjs",
    "test:import-meta-jacket": "node scripts/verify-import-meta-jacket.mjs",
    "test:grenze-titles": "node scripts/verify-grenze-titles.mjs",
    "test:profile-avatar": "node scripts/verify-profile-avatar-color.mjs",
    "test:profile-locale": "node scripts/verify-profile-locale.mjs",
    "test:toasts": "node scripts/verify-toasts.mjs",
    "probe:googlebooks": "node scripts/probe-google-books.mjs",
    "probe:covers": "node scripts/probe-solo-leveling-covers.mjs",
    "test": "npm run test:remap && npm run test:cbz && npm run test:epub && npm run test:pdf && npm run test:watcher && npm run test:haptics && npm run test:series && npm run test:series-folder && npm run test:metadata && npm run test:meta-mappers && npm run test:provider-test && npm run test:bounds && npm run test:setup-focus && npm run test:theme-accents && npm run test:i18n && npm run test:focus-scroll && npm run test:stick-nav && npm run test:text-input && npm run test:hud-modal && npm run test:gamepad-reader && npm run test:book-focus && npm run test:reader-strip && npm run test:page-view && npm run test:library-all-tab && npm run test:library-nav-continue && npm run test:library-empty && npm run test:import-list-detail && npm run test:import-meta-search && npm run test:import-meta-jacket && npm run test:app-routes && npm run test:meta-apply-fields && npm run test:plain-clone && npm run test:series-tome && npm run test:adjacent-tome && npm run test:perf-cache && npm run test:grenze-titles && npm run test:profile-avatar && npm run test:profile-locale && npm run test:toasts",
    "reset:library": "node scripts/reset-library.mjs",
    "reset:app": "node scripts/reset-library.mjs --setup",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "predist": "npm run rebuild:native",
    "predist:win": "npm run rebuild:native",
    "dist": "npm run build && electron-builder --win",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "pack": "npm run dist:dir"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.2.5",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^41.10.7",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.librarychronicles.verticaldeckreader",
    "productName": "Vertical Deck Reader",
    "copyright": "Copyright © Library Chronicles",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.{node,dll}",
      "**/better-sqlite3/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vertical Deck Reader"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "npmRebuild": true,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "electronLanguages": [
      "fr",
      "en-US"
    ]
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  }
}
